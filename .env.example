# PostgreSQL
POSTGRES_DB=dbms_lab
POSTGRES_USER=dbms_lab_user
POSTGRES_PASSWORD=dbms_lab_password
POSTGRES_PORT=5432

# Backend
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=dbms_lab;Username=dbms_lab_user;Password=dbms_lab_password

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# API tests: provision an Author in this project's Docker Compose database.
TEST_PROVISION_AUTHOR=1
# TEST_AUTHOR_EMAIL=
# TEST_AUTHOR_PASSWORD=

# JWT
JWT_KEY=

# Demo data seed: set to "true" to fill the database with the demo course
# after migrations have been applied. Not for production use.
SEED_DEMO_DATA=
